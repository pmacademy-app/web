# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (NEVER expose to browser, no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Primary email provider. Resolved by resolvePrimaryProvider() and shared by both the
# direct transport (lib/email.ts) and the queue's provider registry, so auth mail and
# queued mail always leave via the same sender identity.
# Order: this value -> Brevo if BREVO_API_KEY -> Resend if RESEND_API_KEY -> Brevo.
# The other configured provider is the automatic failover target (one attempt).
PRIMARY_EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_FROM_EMAIL=welcome@prodily.adityagangwani.me
BREVO_WEBHOOK_SECRET=your_brevo_webhook_secret_here
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=welcome@prodily.adityagangwani.me
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
SEND_EMAIL_HOOK_SECRET=v1,your_supabase_send_email_hook_secret


# Canonical Application URL (used for certificate links, QR codes, email unsubscribe links)
# Set to your production URL. Trailing slash is stripped automatically.
NEXT_PUBLIC_SITE_URL=https://prodily.adityagangwani.me

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin Console Authorization (Comma-separated admin email list)
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Cron Job Scheduler Security Secret
CRON_SECRET=your_cron_secret_token

# Cloudflare Turnstile (signup + resend-verification bot protection)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is PUBLIC and client-safe: it is inlined into the
# browser bundle at build time. It is REQUIRED for a production build — the build
# fails without it, because a missing value ships a signup page whose challenge never
# renders (see lib/security/turnstile-env.ts).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY is SERVER-ONLY. Never give it a NEXT_PUBLIC_ prefix, never
# reference it from client code, and never commit a real value — production reads it
# from the deployment environment. If it is missing in production the signup and
# resend-verification routes fail closed rather than letting a request through.
TURNSTILE_SECRET_KEY=
# Local development only. Skips Cloudflare verification entirely; it is ignored when
# NODE_ENV=production, so it can never weaken a deployed environment.
# DEV_TURNSTILE_BYPASS=true

# ─── Legal operator identity & grievance contact ──────────────────────────────
#
# Consumed by lib/legal/legal-config.ts and rendered on /terms, /privacy and the
# site footer. Every value is OPTIONAL to the build but REQUIRED before a public
# launch: while a value is unset, the legal pages state plainly that Prodily is a
# brand name and not a registered company, and they name no operator.
#
# Do NOT populate these with a guess. A wrong legal name, registration number or
# address on a public legal document is worse than an honest "not yet registered".
#
# NEXT_PUBLIC_* values are inlined at BUILD time: set these in the deployment
# environment (e.g. Vercel project settings) too, or the deployed pages fall back
# to the unconfigured wording.

# 'true' ONLY once a genuine company/LLP/firm registration exists.
NEXT_PUBLIC_LEGAL_ENTITY_REGISTERED=false
# The name the Service trades under: the registered company name where one exists,
# otherwise the business name the proprietor operates under.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=Prodily
# Full legal name of the natural person operating an unregistered proprietorship.
# Required while REGISTERED is false — it is what makes "operated by ..." accurate.
NEXT_PUBLIC_LEGAL_PROPRIETOR_NAME=Aditya Gangwani
# How the operator is constituted, e.g. "Private Limited Company", "Sole Proprietor".
NEXT_PUBLIC_LEGAL_ENTITY_TYPE=Sole Proprietor
# CIN / LLPIN / GSTIN / registration number. Required when REGISTERED is true.
# Intentionally blank: Prodily is not separately registered or incorporated.
NEXT_PUBLIC_LEGAL_REGISTRATION_ID=
# Full postal address of the operator, as one pre-formatted line.
NEXT_PUBLIC_LEGAL_ADDRESS=Cozystay Inspire, 6th Main Road, A.K. Colony Mathikere Extension, Bangalore, Karnataka 560054
# Person accountable for grievances and data-protection requests.
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=Aditya Gangwani
NEXT_PUBLIC_GRIEVANCE_OFFICER_TITLE=Founder & Grievance Officer
# Dedicated grievance mailbox. Falls back to BRAND.supportEmail when unset.
NEXT_PUBLIC_GRIEVANCE_EMAIL=hello@prodily.adityagangwani.me

# ─── Search engine verification & GTM (Optional) ──────────────────────────────
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_token
# NEXT_PUBLIC_BING_SITE_VERIFICATION=your_bing_site_verification_token
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── Phase 4: Unit of Work Recut Experiment ──────────────────────────────────
# A/B experiment flag for Core vs Deep-dive curriculum split (lib/academy/experiment.ts).
# Defaults to control ('false') when unset.
RECUT_EXPERIMENT_ENABLED=false
RECUT_EXPERIMENT_TREATMENT_PCT=50

# ─── Phase 6: Module-Entry Unlock Experiment ─────────────────────────────────
# Cohort experiment for the module-entry unlock model (lib/academy/module-entry-unlock.ts).
# Defaults to control ('false') when unset: every learner keeps the global-sequential lock.
# Enabling it is the whole rollout; setting it back to 'false' is the whole rollback (no deploy).
MODULE_ENTRY_UNLOCK_ENABLED=false
# Treatment share WITHIN the eligible cohort, 0–100. Default 100 (the cohort is already
# narrowed by the start date below); set e.g. 50 to run a partial split within the cohort.
MODULE_ENTRY_UNLOCK_TREATMENT_PCT=100
# Restrict the experiment to NEW SIGNUPS: only learners whose users.created_at is on/after this
# ISO date are eligible; everyone created earlier stays control. Leave UNSET to apply to all
# enabled learners (not recommended). Set this to the enablement date before turning the flag on.
# MODULE_ENTRY_UNLOCK_COHORT_START=2026-01-01T00:00:00Z

# ─── Phase 7: Capstone Eligibility Threshold Experiment ───────────────────────
# Cohort experiment for the capstone submission gate (lib/capstone-threshold-experiment.ts).
# Server-only (no NEXT_PUBLIC_ prefix); enforced server-side in lib/capstones-db.ts.
# Defaults to CONTROL ('false') when unset: every learner keeps the 8-of-10 gate. Enabling it is
# the whole rollout; setting it back to 'false' is the whole rollback (no deploy).
#
# NOTE: the authoritative baseline keeps 8-of-10 for Phase 7; this experiment is the blueprint's
# lower-threshold test. It ships OFF by default — do NOT enable in production without product
# sign-off (see docs/decisions/ADR-009-phase-7-make-payoff-visible.md and docs/PHASE_HISTORY.md).
CAPSTONE_THRESHOLD_EXPERIMENT_ENABLED=false
# Treatment share WITHIN the eligible cohort, 0–100. Default 100 (the cohort is already narrowed by
# the start date below); set e.g. 50 to run a partial split within the cohort.
CAPSTONE_THRESHOLD_TREATMENT_PCT=100
# Lessons required for eligibility under TREATMENT. Default 4 (the blueprint's "e.g. 4 lessons").
# Clamped to 1–8; a value above the 8-of-10 control is refused (it would reduce access) and falls
# back to the default. Control is always 8 and is not configurable.
CAPSTONE_THRESHOLD_TREATMENT_LESSONS=4
# Restrict the experiment to NEW SIGNUPS: only learners whose users.created_at is on/after this ISO
# date are eligible; everyone created earlier stays control (8-of-10). Leave UNSET to apply to all
# enabled learners (not recommended). Set this to the enablement date before turning the flag on.
# CAPSTONE_THRESHOLD_COHORT_START=2026-01-01T00:00:00Z

# ─── Phase 8: Read the results, close the loop ────────────────────────────────
# Phase 8 introduced NO new environment variables.
#  • 8.1 experiment readout (/admin/analytics/experiments) reads the SAME experiment
#    flags above (Phase 4/6/7) and adds no config of its own.
#  • 8.2 capstone review loop is gated only by the additive DB migration
#    (supabase/migrations/20261001000001_phase8_capstone_review_loop.sql) — run it BEFORE
#    deploying the Phase 8 code. The `capstone.reviewed` in-app notification is governed by
#    the IN_APP_NOTIFICATIONS_ENABLED FEATURE FLAG (see note below), not by any env var.
#
# NOTE — IN_APP_NOTIFICATIONS_ENABLED is NOT an environment variable. It is a database-backed
# feature flag (system_settings.feature_flags), defaults to ON, and is toggled from the admin
# console (Communications → Feature Flags). Do not add it here.

# ─── Operational / optional (safe to leave unset) ─────────────────────────────
# Everything below has a working default; the app runs without any of them. They are listed
# so operators know they exist. Do NOT set REDIS_URL — Prodily uses Postgres for rate limits
# and the email queue; Redis is intentionally not a dependency.

# Retention hard-delete kill switch (app/api/cron/cleanup). Defaults to DRY-RUN when unset or
# not 'true': the cleanup cron reports what it WOULD delete but deletes nothing. Set to 'true'
# only when you intend real retention deletion to run.
# RETENTION_DELETE_ENABLED=false

# Out-of-band alert webhook (lib/monitoring/out-of-band-alert.ts). When set, critical incidents
# POST here as a fallback path independent of the database. Unset = no out-of-band alerts.
# ALERT_WEBHOOK_URL=

# Admin dashboard time zone (lib/admin/dashboard-aggregation.ts). Defaults to the server's
# resolved zone, then UTC. Set an IANA name to pin admin day-boundaries, e.g. Asia/Kolkata.
# ADMIN_TIMEZONE=UTC

# Notification queue dispatch concurrency (lib/notifications/queue/processor.ts). Default 5.
# QUEUE_DISPATCH_CONCURRENCY=5

# Trusted proxy hop count for client-IP resolution (lib/security/client-ip.ts). Default 0
# (trust only the edge-observed IP). Raise ONLY if real infrastructure is added in front of
# Vercel and confirmed to APPEND rather than replace X-Forwarded-For.
# TRUSTED_PROXY_HOP_COUNT=0

# Campaign sender overrides (lib/campaigns/portfolio-activation-runner.ts). Both fall back to
# built-in defaults when unset.
# CAMPAIGN_FROM_EMAIL=
# CAMPAIGN_REPLY_TO_EMAIL=

# Email simulation for local/dev: when 'true', the matching provider logs instead of sending.
# Leave unset/false in production. (lib/email.ts, providers/*-provider.ts)
# BREVO_SIMULATE=false
# RESEND_SIMULATE=false

# Ops capability tokens — SERVER-ONLY SECRETS, optional. Only used by the admin System page to
# report whether managed operations are wired up (lib/admin/system-service.ts). Never commit real
# values; set them in the deployment environment if you use those integrations.
# VERCEL_API_TOKEN=
# SUPABASE_MANAGEMENT_API_KEY=

